<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="MahApps.Metro"            Version="3.0.0-rc0529" />
		<PackageVersion Include="MahApps.Metro.IconPacks"  Version="6.2.1"        />
		<PackageVersion Include="Microsoft.Data.Sqlite"    Version="10.0.12"      />
		<PackageVersion Include="CodeJam"                  Version="5.0.0"        />
		<PackageVersion Include="Dapper"                   Version="2.1.89"       />
		<PackageVersion Include="PetaPoco.Compiled"        Version="6.0.683"      />
		<PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1"        />
		<PackageVersion Include="EntityFramework"          Version="6.5.2"        />
		<PackageVersion Include="BLToolkit"                Version="4.3.9"        />
		<PackageVersion Include="linq2db.t4models"         Version="6.5.0"        />
	</ItemGroup>

	<!-- EF Core 3.1 is the last EF Core release that runs on .NET Framework. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net481'">
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="3.1.32" />
	</ItemGroup>
</Project>
