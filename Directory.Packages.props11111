<Project>
	<ItemGroup>
		<PackageVersion Include="MahApps.Metro"            Version="3.0.0-rc0529" />
		<PackageVersion Include="MahApps.Metro.IconPacks"  Version="6.2.1"       />
		<PackageVersion Include="Microsoft.Data.SQLite"    Version="10.0.8"      />
		<PackageVersion Include="CodeJam"                  Version="5.0.0"       />
		<PackageVersion Include="Dapper"                   Version="2.1.79"      />
		<PackageVersion Include="PetaPoco.Compiled"        Version="6.0.683"     />
		<PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.1"       />
		<PackageVersion Include="EntityFramework"          Version="6.4.4"   />
		<PackageVersion Include="BLToolkit"                Version="4.3.9"   />
		<PackageVersion Include="linq2db"                  Version="6.3.0"   />
		<PackageVersion Include="linq2db.t4models"         Version="6.2.1"   />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.24" />
	</ItemGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'net481'">
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="3.1.32" />
	</ItemGroup>
</Project>
