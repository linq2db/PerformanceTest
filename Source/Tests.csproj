<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;net481</TargetFrameworks>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\TestRunner\TestRunner.csproj" />
		<PackageReference Include="CodeJam" />
		<PackageReference Include="Dapper" />
		<PackageReference Include="PetaPoco.Compiled" />
		<PackageReference Include="Microsoft.Data.SqlClient" />

		<ProjectReference Include="..\..\linq2db\Source\LinqToDB\LinqToDB.csproj" />
		<ProjectReference Include="..\..\linq2db\Source\LinqToDB.Remote.Wcf\LinqToDB.Remote.Wcf.csproj" Condition="'$(TargetFramework)' == 'net481'" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Remove="L2S\*" />
		<Compile Remove="EF6\*" />
		<Compile Remove="BLToolkit\*" />
		<Compile Remove="L2DB\LoWcf*.cs" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net481'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="EntityFramework" />
		<PackageReference Include="BLToolkit" />

		<Reference Include="System.Data.Linq" />
		<Reference Include="System.ServiceModel" />

		<Compile Remove="Core\*" />
	</ItemGroup>
</Project>
